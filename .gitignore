# Node modules
node_modules/
client/node_modules/
server/node_modules/

# Build artifacts
dist/
client/dist/

# Local databases & uploads (don't commit generated temporary files)
server/data/*.db
server/generated_certs/*.pdf
server/uploads/*
!server/uploads/.gitkeep

# Environment variables
.env
.env.local
.env.*.local

# Vercel output
.vercel/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
